{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "right": 4
    }
  },
  "display": {
    "pipe": false,
    "separator": " 󰄾 ",
    "color": {
      "keys": "yellow",
      "title": "yellow"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "{#yellow}──────────────────────────────"
    },
    {
      "type": "os",
      "key": " OS  ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "󰆍 Ker ",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "key": "󰅐 Up  ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "󰏖 Pkg ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": " Sh  ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "󰟀 WM  ",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU ",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU ",
      "keyColor": "yellow",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰘚 Mem ",
      "keyColor": "yellow",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "custom",
      "format": "{#yellow}──────────────────────────────"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
